<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data>

    <!-- ── LIST VIEW ────────────────────────────────────────
         Shows all students as rows in a table
    ──────────────────────────────────────────────────────── -->
    <record id='view_student_lead_tree' model='ir.ui.view'>
      <field name='name'>student.lead.tree</field>
      <field name='model'>student.lead</field>
      <field name='arch' type='xml'>
        <list string='Students' edit='true' delete='true'>
          <field name='name'/>
          <field name='phone_full'/>
          <field name='email'/>
          <field name='country_id'/>
          <field name='specialization'/>
          <field name='status'/>
          <field name="user_id" string="Added By"/>
          <field name='currency_id' optional='hide'/>
          <field name='budget_display'/>
          <field name='follow_up_date'/>
        </list>
      </field>
    </record>

    <!-- ── FORM VIEW ────────────────────────────────────────
         Shows full details of one student
    ──────────────────────────────────────────────────────── -->
    <record id='view_student_lead_form' model='ir.ui.view'>
      <field name='name'>student.lead.form</field>
      <field name='model'>student.lead</field>
      <field name='arch' type='xml'>
        <form string='Student Lead'>

          <!-- ── HEADER BAR ──────────────────────────────────
               Shows current status as colored badge
               Save ☁️ and Discard ✕ appear automatically
          ─────────────────────────────────────────────────── -->
          <header>
            <field name='status' widget='badge'/>
          </header>

          <sheet>

            <!-- ── BUTTON BOX ─────────────────────────────────
                 Top right — navigation buttons
            ─────────────────────────────────────────────────── -->
            <div class="oe_button_box" name="button_box">
              <button type="action"
                      name="%(action_student_lead)d"
                      string="All Students"
                      class="oe_stat_button"
                      icon="fa-users"/>
            </div>

            <!-- Big title — student name -->
            <div class='oe_title'>
              <h1>
                <field name='name' placeholder='Student Name...'/>
              </h1>
            </div>

            <!-- ── CONTACT INFORMATION ─────────────────────────
                 Left column — phone and contact details
                 Right column — status and dates
            ─────────────────────────────────────────────────── -->
            <group string='Contact Information'>
              <!-- Left column -->
              <group>
                <!-- Country code + phone number -->
                <field name='phone_country_id' string='Country Code'/>
                <field name='phone' string='Phone Number'/>
                <!-- Full phone auto generated — read only -->
                <field name='phone_full' readonly='1'/>
                <!-- Second phone — parent or alternative number -->
                <field name='phone2' string='Second Phone'/>
                <!-- Email — for portal invitation -->
                <field name='email'/>
                <!-- Nationality — searchable all countries -->
                <field name='country_id' string='Nationality'/>
                <!-- What student wants to study -->
                <field name='specialization'/>
              </group>
              <!-- Right column -->
              <group>
                <!-- Status — change anytime -->
                <field name='status'/>
                <!-- Currency — USD, EUR, TRY -->
                <field name='currency_id'/>
                <!-- Date first contacted -->
                <field name='date_contacted'/>
                <!-- Date to follow up -->
                <field name='follow_up_date'/>
              </group>
            </group>

            <!-- ── BUDGET SECTION ──────────────────────────────
                 Left = exact budget
                 Right = budget range
            ─────────────────────────────────────────────────── -->
            <group string='Budget'>
              <group string='Exact Budget'>
                <field name='budget_amount' nolabel='1'/>
              </group>
              <group string='Budget Range'>
                <field name='budget_min'/>
                <field name='budget_max'/>
              </group>
            </group>

            <!-- ── TABS ────────────────────────────────────────
                 Notes tab — more tabs coming soon
            ─────────────────────────────────────────────────── -->
            <notebook>
              <page string='Notes'>
                <field name='notes' placeholder='Add notes...'/>
              </page>
            </notebook>

          </sheet>
        </form>
      </field>
    </record>

    <!-- ── ACTION ───────────────────────────────────────────
         Connects menu to views
    ──────────────────────────────────────────────────────── -->
    <record id='action_student_lead' model='ir.actions.act_window'>
      <field name='name'>Students</field>
      <field name='res_model'>student.lead</field>
      <field name='view_mode'>list,form</field>
    </record>

  </data>
</odoo>