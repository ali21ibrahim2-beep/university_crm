# ── Student Lead Model ───────────────────────────────────────
# The main CRM record. One row per prospective student; tracks
# contact info, chosen program, budget, status and the portal
# token + password hash used by StudentPortal.vue.

from odoo import models, fields, api
from odoo.exceptions import ValidationError
import re
import uuid


class StudentLead(models.Model):

    _name = 'student.lead'
    _description = 'Student Lead'
    _inherit = ['mail.thread']   # mail.activity.mixin removed — no discussions
    _order = 'date_contacted desc'

    # ── BASIC INFORMATION ────────────────────────────────────
    # Name, owner, contact fields. phone_country_id drives the
    # "+code" prefix shown in the phone input.

    name = fields.Char(string='Student Name', required=True)

    user_id = fields.Many2one(
        'res.users',
        string='Assigned To',
        default=lambda self: self.env.user,
        # tracking=True removed
    )

    email = fields.Char(string='Email')
    phone2 = fields.Char(string='Second Phone')

    phone_country_id = fields.Many2one(
        'res.country',
        string='Country Code',
        default=lambda self: self.env['res.country'].search(
            [('code', '=', 'TR')], limit=1
        )
    )

    phone_code_display = fields.Char(
        string='Code',
        compute='_compute_phone_code',
        store=False
    )

    @api.depends('phone_country_id')
    def _compute_phone_code(self):
        for rec in self:
            if rec.phone_country_id and rec.phone_country_id.phone_code:
                rec.phone_code_display = f'+{rec.phone_country_id.phone_code}'
            else:
                rec.phone_code_display = ''

    phone_placeholder = fields.Char(
        string='Phone Placeholder',
        compute='_compute_phone_placeholder',
        store=False
    )

    @api.depends('phone_country_id')
    def _compute_phone_placeholder(self):
        placeholders = {
            'TR': '5XX XXX XX XX',
            'US': 'XXX XXX XXXX',
            'GB': 'XXXX XXX XXXX',
            'SA': '5X XXX XXXX',
            'AE': '5X XXX XXXX',
            'YE': '7XX XXX XXX',
            'IQ': '7XX XXX XXXX',
            'SY': '9XX XXX XXX',
            'JO': '7X XXX XXXX',
            'EG': '1XX XXX XXXX',
            'DE': 'XXX XXXXXXXX',
            'FR': 'X XX XX XX XX',
        }
        for rec in self:
            if rec.phone_country_id:
                code = rec.phone_country_id.code
                rec.phone_placeholder = placeholders.get(code, 'Enter phone number')
            else:
                rec.phone_placeholder = 'Enter phone number'

    phone = fields.Char(string='Phone Number')

    country_id = fields.Many2one('res.country', string='Nationality')

    # ── PORTAL TOKEN ─────────────────────────────────────────
    # Unique token used to identify the student on the portal.
    # Generated once when the student is created.
    # The employee copies the link and gives it to the student.

    portal_token = fields.Char(
        string='Portal Token',
        copy=False,
        default=lambda self: str(uuid.uuid4()),
    )

    portal_url = fields.Char(
        string='Portal Link',
        compute='_compute_portal_url',
        store=False,
    )

    @api.depends('portal_token')
    def _compute_portal_url(self):
        base = self.env['ir.config_parameter'].sudo().get_param(
            'web.base.url', 'http://localhost:8069'
        )
        for rec in self:
            rec.portal_url = f'{base}/my/application/{rec.portal_token}'


    # ── PORTAL PASSWORD ─────────────────────────────────────
    # SHA-256 hash of the student portal password.
    # Set by the student on their first login via the portal link.

    portal_password_hash = fields.Char(
        string='Portal Password Hash',
        copy=False,
        help='SHA-256 hash of the student portal password. Set by student on first login.',
    )

    # ── DEGREE AND SPECIALIZATION ────────────────────────────
    # Program the student is applying for. "other" + free text
    # covers specializations outside the preset list.

    degree_level = fields.Selection([
        ('bachelor', 'Bachelor'),
        ('master', 'Master'),
        ('phd', 'PhD / Doctorate'),
        ('diploma', '2-Year Diploma'),
    ], string='Degree Level')

    specialization = fields.Selection([
        ('medicine', 'Medicine'),
        ('dentistry', 'Dentistry'),
        ('pharmacy', 'Pharmacy'),
        ('nursing', 'Nursing'),
        ('veterinary', 'Veterinary Medicine'),
        ('civil_eng', 'Civil Engineering'),
        ('mechanical_eng', 'Mechanical Engineering'),
        ('electrical_eng', 'Electrical Engineering'),
        ('computer_eng', 'Computer Engineering'),
        ('software_eng', 'Software Engineering'),
        ('chemical_eng', 'Chemical Engineering'),
        ('architecture', 'Architecture'),
        ('business_admin', 'Business Administration'),
        ('accounting', 'Accounting & Finance'),
        ('economics', 'Economics'),
        ('marketing', 'Marketing'),
        ('law', 'Law'),
        ('political_science', 'Political Science'),
        ('psychology', 'Psychology'),
        ('sociology', 'Sociology'),
        ('computer_science', 'Computer Science'),
        ('mathematics', 'Mathematics'),
        ('physics', 'Physics'),
        ('chemistry', 'Chemistry'),
        ('biology', 'Biology'),
        ('education', 'Education'),
        ('english_lit', 'English Literature'),
        ('translation', 'Translation'),
        ('other', 'Other'),
    ], string='Academic Specialization')

    specialization_other = fields.Char(string='Other Specialization')

    specialization_display = fields.Char(
        string='Specialization Display',
        compute='_compute_specialization_display',
        store=True,
    )

    @api.depends('specialization', 'specialization_other')
    def _compute_specialization_display(self):
        spec_labels = dict(self._fields['specialization'].selection)
        for rec in self:
            if rec.specialization == 'other' and rec.specialization_other:
                rec.specialization_display = rec.specialization_other
            elif rec.specialization:
                rec.specialization_display = spec_labels.get(
                    rec.specialization, rec.specialization
                )
            else:
                rec.specialization_display = ''

    # ── CURRENCY AND BUDGET ──────────────────────────────────
    # Either a single amount or a min/max range. budget_display
    # formats whichever is set with the chosen currency symbol.

    currency_id = fields.Many2one(
        'res.currency',
        string='Currency',
        default=lambda self: self.env['res.currency'].search(
            [('name', '=', 'USD')], limit=1
        )
    )

    budget_amount = fields.Monetary(string='Budget', currency_field='currency_id')
    budget_min = fields.Monetary(string='Budget From', currency_field='currency_id')
    budget_max = fields.Monetary(string='Budget To', currency_field='currency_id')

    budget_display = fields.Char(
        string='Budget',
        compute='_compute_budget_display',
        store=True
    )

    @api.depends('budget_amount', 'budget_min', 'budget_max', 'currency_id')
    def _compute_budget_display(self):
        for rec in self:
            currency = rec.currency_id.symbol or '$'
            if rec.budget_min and rec.budget_max:
                rec.budget_display = (
                    f'{currency} {rec.budget_min:,.0f} - {currency} {rec.budget_max:,.0f}'
                )
            elif rec.budget_amount:
                rec.budget_display = f'{currency} {rec.budget_amount:,.2f}'
            else:
                rec.budget_display = ''

    # ── STATUS AND DATES ─────────────────────────────────────
    # Pipeline state + free-text notes. Matches STATUS_STEPS on
    # the Vue side (new → options_sent → chosen → docs → enrolled).

    status = fields.Selection([
        ('new', 'New Inquiry'),
        ('options_sent', 'Options Sent'),
        ('chosen', 'University Chosen'),
        ('docs', 'Collecting Documents'),
        ('enrolled', 'Enrolled'),
        ('lost', 'Lost'),
    ], string='Status', default='new')

    date_contacted = fields.Date(string='Date Contacted', default=fields.Date.today)
    follow_up_date = fields.Date(string='Follow-up Date')
    notes = fields.Text(string='Notes')

    # ── FULL PHONE NUMBER ────────────────────────────────────
    # "+code phone" shown in tables and on the portal page.

    phone_full = fields.Char(
        string='Full Phone',
        compute='_compute_phone_full',
        store=True
    )

    @api.depends('phone_country_id', 'phone')
    def _compute_phone_full(self):
        for rec in self:
            if rec.phone_country_id and rec.phone:
                code = rec.phone_country_id.phone_code
                rec.phone_full = f'+{code} {rec.phone}'
            else:
                rec.phone_full = rec.phone or ''

    # ── WHATSAPP LINK ────────────────────────────────────────
    # Click-to-chat URL (wa.me/<digits>) derived from phone_full.

    whatsapp_url = fields.Char(
        string='WhatsApp',
        compute='_compute_whatsapp_url',
        store=False,
    )

    @api.depends('phone_country_id', 'phone')
    def _compute_whatsapp_url(self):
        for rec in self:
            if rec.phone_country_id and rec.phone:
                digits_only = re.sub(r'\D', '', rec.phone)
                code = rec.phone_country_id.phone_code
                rec.whatsapp_url = f'https://wa.me/{code}{digits_only}'
            else:
                rec.whatsapp_url = ''

    # ── EMAIL LINK ───────────────────────────────────────────
    # mailto: URL prefilled with "Re: <student name>" subject.

    email_url = fields.Char(
        string='Email Link',
        compute='_compute_email_url',
        store=False,
    )

    @api.depends('email', 'name')
    def _compute_email_url(self):
        for rec in self:
            if rec.email:
                subject = (rec.name or 'Student').replace(' ', '%20')
                rec.email_url = f'mailto:{rec.email}?subject=Re%3A%20{subject}'
            else:
                rec.email_url = ''

    # ── DOCUMENT COUNT (smart button) ────────────────────────
    # Number of ir.attachment records linked to this student.
    # action_view_attachments opens them in a list/form window.

    attachment_count = fields.Integer(
        string='Documents',
        compute='_compute_attachment_count',
    )

    def _compute_attachment_count(self):
        for rec in self:
            rec.attachment_count = self.env['ir.attachment'].search_count([
                ('res_model', '=', 'student.lead'),
                ('res_id', '=', rec.id),
            ])

    def action_view_attachments(self):
        self.ensure_one()
        return {
            'name': 'Documents',
            'type': 'ir.actions.act_window',
            'res_model': 'ir.attachment',
            'view_mode': 'list,form',
            'domain': [('res_model', '=', 'student.lead'), ('res_id', '=', self.id)],
            'context': {'default_res_model': 'student.lead', 'default_res_id': self.id},
        }

    # ── COPY PORTAL LINK ─────────────────────────────────────
    # Shows the employee a notification with the student's portal URL.
    # They copy it and send it to the student via WhatsApp or email.

    def action_copy_portal_link(self):
        self.ensure_one()
        return {
            'type': 'ir.actions.client',
            'tag': 'display_notification',
            'params': {
                'title': 'Portal Link',
                'message': self.portal_url,
                'type': 'info',
                'sticky': True,
            }
        }

    # ── VALIDATION RULES ─────────────────────────────────────
    # Field-level checks run on create/write: letters-only name,
    # country-specific phone length, budget sanity, "other" spec
    # requires free text.

    @api.constrains('name')
    def _check_name(self):
        for rec in self:
            if rec.name and not re.match(r'^[a-zA-Z\u0600-\u06FF\s]+$', rec.name):
                raise ValidationError(
                    'Student name can only contain letters and spaces!'
                )

    @api.constrains('phone', 'phone_country_id')
    def _check_phone(self):
        for rec in self:
            if not rec.phone:
                continue
            if not re.match(r'^[\d\s\-]+$', rec.phone):
                raise ValidationError('Phone number can only contain numbers!')
            if rec.phone_country_id:
                digits_only = re.sub(r'\D', '', rec.phone)
                fmt = self.env['phone.country.format'].search(
                    [('country_id', '=', rec.phone_country_id.id)], limit=1
                )
                if fmt:
                    if len(digits_only) != fmt.digit_count:
                        raise ValidationError(
                            f'Phone number for {rec.phone_country_id.name} '
                            f'must be exactly {fmt.digit_count} digits. '
                            f'You entered {len(digits_only)} digits.'
                        )
                    if fmt.leading_digit and not digits_only.startswith(fmt.leading_digit):
                        raise ValidationError(
                            f'Phone number for {rec.phone_country_id.name} '
                            f'must start with {fmt.leading_digit}.'
                        )

    @api.constrains('specialization', 'specialization_other')
    def _check_specialization_other(self):
        for rec in self:
            if rec.specialization == 'other' and not rec.specialization_other:
                raise ValidationError(
                    'Please specify the specialization when selecting Other!'
                )

    @api.constrains('budget_amount', 'budget_min', 'budget_max')
    def _check_budget(self):
        for rec in self:
            if rec.budget_amount < 0:
                raise ValidationError('Budget cannot be negative!')
            if rec.budget_min < 0 or rec.budget_max < 0:
                raise ValidationError('Budget range cannot be negative!')
            if rec.budget_min and rec.budget_max and rec.budget_min > rec.budget_max:
                raise ValidationError('Budget From cannot be more than Budget To!')

    # ── ACCESS CONTROL ───────────────────────────────────────
    # Employees only see + delete their own students. Managers
    # and base.group_system users bypass this filter. Works
    # alongside the ir.rule in security/record_rules.xml.

    @api.model
    def _search(self, domain, offset=0, limit=None, order=None):
        is_manager = self.env.user.has_group('university_crm.group_university_manager')
        is_admin = self.env.user.has_group('base.group_system')
        if not is_manager and not is_admin:
            domain = [('user_id', '=', self.env.uid)] + list(domain)
        return super()._search(domain, offset=offset, limit=limit, order=order)

    def unlink(self):
        # Employees can only unlink records they're assigned to.
        is_manager = self.env.user.has_group('university_crm.group_university_manager')
        is_admin = self.env.user.has_group('base.group_system')
        if not is_manager and not is_admin:
            for rec in self:
                if rec.user_id.id != self.env.uid:
                    raise ValidationError('You can only delete your own students!')
        return super().unlink()

    # ── DELETE WIZARD LAUNCHER ───────────────────────────────
    # Opens the transient wizard below so the user has to pick a
    # deletion reason before the record is archived.

    def action_open_delete_wizard(self):
        return {
            'name': 'Delete Student',
            'type': 'ir.actions.act_window',
            'res_model': 'student.lead.delete.wizard',
            'view_mode': 'form',
            'view_id': self.env.ref('university_crm.view_delete_wizard_form').id,
            'target': 'new',
            'context': {'default_student_ids': self.ids},
        }

    # ── COMMUNICATION BUTTONS ────────────────────────────────
    # Server actions that just open the computed URLs in a new tab.

    def action_open_whatsapp(self):
        self.ensure_one()
        return {'type': 'ir.actions.act_url', 'url': self.whatsapp_url, 'target': 'new'}

    def action_open_email(self):
        self.ensure_one()
        return {'type': 'ir.actions.act_url', 'url': self.email_url, 'target': 'new'}


# ── DELETE REASON WIZARD ─────────────────────────────────────
# Transient model opened by action_open_delete_wizard. Forces
# the user to pick a reason, copies every field to student.archive,
# then unlinks the live records.

class StudentLeadDeleteWizard(models.TransientModel):

    _name = 'student.lead.delete.wizard'
    _description = 'Delete Student Reason'

    student_ids = fields.Many2many('student.lead', string='Students')

    reason = fields.Selection([
        ('enrolled', 'Completed Enrollment'),
        ('paid', 'Paid Fees'),
        ('documents', 'Completed Document Upload'),
        ('other', 'Other'),
    ], string='Reason for Deletion', required=True)

    other_reason = fields.Text(string='Please Specify')

    def action_confirm_delete(self):
        if self.reason == 'other' and not self.other_reason:
            raise ValidationError('Please specify the reason for deletion!')

        for student in self.student_ids:
            self.env['student.archive'].create({
                'name': student.name,
                'email': student.email,
                'phone': student.phone,
                'phone2': student.phone2,
                'phone_full': student.phone_full,
                'phone_country_id': student.phone_country_id.id,
                'country_id': student.country_id.id,
                'degree_level': student.degree_level,
                'specialization': student.specialization,
                'specialization_other': student.specialization_other,
                'status': student.status,
                'currency_id': student.currency_id.id,
                'budget_amount': student.budget_amount,
                'budget_min': student.budget_min,
                'budget_max': student.budget_max,
                'date_contacted': student.date_contacted,
                'follow_up_date': student.follow_up_date,
                'notes': student.notes,
                'user_id': student.user_id.id,
                'deleted_by': self.env.user.id,
                'delete_reason': self.reason,
                'delete_reason_text': self.other_reason or '',
            })

        self.student_ids.unlink()
        return {'type': 'ir.actions.act_window_close'}